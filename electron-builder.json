{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.markstratum.pdf",
  "productName": "MarkStratum",
  "asar": true,
  "npmRebuild": false,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    "package.json",
    {
      "from": "node_modules/pdfium-native/build/Release",
      "to": "node_modules/pdfium-native/build/Release",
      "filter": ["*.node", "*.dll", "*.dylib", "*.so"]
    }
  ],
  "asarUnpack": [
    "**/node_modules/pdfium-native/build/Release/**"
  ],
  "mac": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "category": "public.app-category.productivity",
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "linux": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "category": "Office",
    "target": [
      "AppImage",
      "deb"
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "fileAssociations": [
    {
      "ext": "pdf",
      "name": "PDF Document",
      "role": "Viewer"
    }
  ]
}
